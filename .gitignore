# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example IS the documentation for every var — always commit it.
!.env.example

# Prisma: generated client is a build artifact, regenerated on postinstall.
/src/generated/

# Local SQLite database and its WAL sidecars. In production this lives on the
# Render disk mount instead, well outside the checked-out repo.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# Local upload directory. Production writes to the disk mount (UPLOAD_DIR).
/var/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP scratch output (screenshots, snapshots)
.playwright-mcp/
