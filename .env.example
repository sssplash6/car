# ==============================================================================
# freshman.academy paper publication site
# ==============================================================================
# Copy to .env for local development. .env is git-ignored; this file is the
# documentation, so keep it in sync with the table in README.md.
#
# Load-bearing vars — the ones that cause damage rather than an obvious failure:
#   DATABASE_URL and UPLOAD_DIR   wrong values mean SILENT DATA LOSS on Render
#   AUTH_SECRET                   sign-in breaks on every restart without it
#   ADMIN_EMAILS                  blank means nobody can ever publish a paper

# --- Database ---
# SQLite file. On Render this MUST sit at the ROOT of the mounted disk
# (file:/var/data/car.db): the filesystem outside the mount is wiped on every
# deploy, and sqlite will not create missing parent directories, so a nested path
# like /var/data/db/car.db fails on first boot.
DATABASE_URL="file:./prisma/dev.db"

# --- Uploaded papers ---
# Where submitted PDFs are written. On Render point this inside the mounted disk
# (/var/data/uploads) or every uploaded paper is discarded on the next deploy.
# Unlike DATABASE_URL this may nest — the code creates the path recursively.
# MUST stay outside public/: anything under public/ is served statically with no
# auth check, which would hand out every gated PDF to anyone who guessed a name.
# Defaults to ./var/uploads when unset, which is fine for local dev.
UPLOAD_DIR=

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret
# Signs the session cookie. If unset, Auth.js uses an ephemeral value and every
# server restart silently signs everyone out.
AUTH_SECRET="replace-me"

# Google OAuth credentials — the only sign-in method.
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://YOUR-DOMAIN/api/auth/callback/google
# When EITHER of these is blank the login page says so plainly instead of
# rendering a button that dead-ends on Google's error screen. Both are checked:
# an id with no secret is the nastiest case, because the button works right up
# until the callback and then fails with an opaque Configuration error.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Dev only ---
# Enables one-click "Continue as reader / Continue as editor" buttons on /login
# that bypass Google entirely, for local testing before OAuth is configured.
#
# This is a COMPLETE AUTHENTICATION BYPASS, so it is guarded three times: the flag
# must be "true", NODE_ENV must not be "production", AND NEXT_PUBLIC_SITE_URL must
# be localhost. When any one fails the provider is not registered at all — the
# sign-in endpoint returns a Configuration error rather than a session.
#
# The NODE_ENV guard is not redundant. NEXT_PUBLIC_SITE_URL is inlined into the
# bundle at build time, so the localhost check is frozen at `next build` and does
# not reflect the deployed environment; a production build that ran without that
# var set would freeze it as "localhost". NODE_ENV is a real per-process read, so
# it holds regardless of how the bundle was built. Do not relax any condition.
#
# The dev editor account is dev-admin@freshman.academy and is only an ADMIN if
# that address appears in ADMIN_EMAILS below; the bypass grants no role by itself.
ALLOW_DEV_LOGIN="false"

# --- Editors ---
# Comma-separated emails promoted to ADMIN on sign-in. Only admins can publish or
# return submissions, so leaving this blank produces a working site where papers
# pile up in the queue with no way to publish them — set it before going live.
# Recomputed on every sign-in: removing an address here demotes that person the
# next time they log in. There is deliberately no in-app UI for changing roles.
ADMIN_EMAILS="tech@freshman.academy"

# --- Site URL ---
# Absolute origin, no trailing slash. Used for canonical tags, OG tags, the
# sitemap, and links inside decision emails. The localhost default is for dev
# only — left unset in production it emits wrong canonical URLs, which tells
# Google the real pages are duplicates of a localhost address.
#
# NEXT_PUBLIC_* is INLINED AT BUILD TIME. This value is frozen into the bundle by
# `next build`, so on Render it must be set before the first build, and changing
# it later requires a full redeploy rather than a restart. It also feeds the
# localhost check that helps gate ALLOW_DEV_LOGIN above.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend) ---
# Authors are emailed when a paper is published or returned. When RESEND_API_KEY
# is unset (local dev) the message is logged to the server console instead, so
# the review flow still works end-to-end without a mail account.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender. Must be on a domain verified in Resend; defaults to Resend's
# onboarding sender if unset, which is fine for testing but not for real mail.
MAIL_FROM="Freshman Academy <noreply@yourdomain.com>"
